DATABASE_URL=postgresql+psycopg://neurox:neurox@localhost:5432/neurox
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_KEY_ID=current
JWT_PREVIOUS_SECRETS=
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0
PUBLIC_WEB_URL=http://localhost:5173

# Firebase / FCM (production push notifications)
# Keep the service-account JSON in a secret manager; do not commit the file.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to inline JSON (preferred): FIREBASE_SERVICE_ACCOUNT_JSON_FILE=/run/secrets/firebase.json
FIREBASE_SERVICE_ACCOUNT_JSON_FILE=
FCM_ENABLED=false
FCM_TIMEOUT_SECONDS=10
FCM_DEVICE_TOKEN_TTL_DAYS=90

# Transactional email (verification, password reset, caregiver alerts)
# SMTP_PASSWORD must be supplied through the deployment secret manager.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@neurox.local
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# SMS provider. Select exactly one provider in deployment.
# Generic webhook mode (currently supported by the backend):
SMS_GATEWAY_URL=https://sms-provider.example/messages
SMS_GATEWAY_TOKEN=replace-with-provider-token
# Twilio (use HTTPS API from a backend worker; never expose these to clients)
SMS_PROVIDER=webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 (if selected instead of Twilio)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# BHASHINI / ULCA speech-to-text (regional-language ASR)
# Obtain these from the BHASHINI integrator portal. Keep keys server-side.
BHASHINI_ENABLED=false
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TIMEOUT_SECONDS=20
BHASHINI_MAX_AUDIO_SECONDS=30

# Optional remote Whisper-compatible ASR fallback (server-side only)
WHISPER_ENABLED=false
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_TIMEOUT_SECONDS=20

# Calibrated LASI research model. Mount/copy the artifact at deploy time.
COGNITIVE_MODEL_PATH=/app/models/lasi_baseline/lasi_low_recall_calibrated.joblib
COGNITIVE_MODEL_SHA256=

# Operational safeguards for notification and speech workers
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BACKOFF_SECONDS=10
NOTIFICATION_OUTBOX_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Absolute directory containing production Docker secret files (deploy host only).
NEUROX_SECRETS_DIR=/opt/neurox/secrets
# Development only: set to false to start with an empty database.
SEED_DEMO_DATA=true
DEMO_CAREGIVER_EMAIL=anita@neurox.demo
DEMO_CAREGIVER_PASSWORD=replace-with-a-local-only-password
DEMO_PATIENT_EMAIL=maya@neurox.demo
DEMO_PATIENT_PASSWORD=replace-with-a-local-only-password
